# Local MVP configuration. Copy this file to .env before starting Docker Compose.

POSTGRES_DB=docengine
POSTGRES_USER=docengine
POSTGRES_PASSWORD=docengine-local-password

RABBITMQ_USER=docengine
RABBITMQ_PASS=docengine-local-password

MINIO_ROOT_USER=docengine
MINIO_ROOT_PASSWORD=docengine-local-password

MINIO_INPUT_BUCKET=docengine-inputs
MINIO_RESULT_BUCKET=docengine-results
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# docker compose --env-file .env -f docs/docker-compose.mvp.yml up -d --build

PGADMIN_DEFAULT_EMAIL=admin@docengine.com
PGADMIN_DEFAULT_PASSWORD=docengine-pgadmin-password

# Grafana local-development login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=docengine-grafana-local-password

SPRING_PROFILES_ACTIVE=mvp









# $env:Path += ";C:\Program Files\k6"
k6 version

$userPath = [Environment]::GetEnvironmentVariable("Path", "User")

if ($userPath -notlike "*C:\Program Files\k6*") {
    [Environment]::SetEnvironmentVariable(
        "Path",
        "$userPath;C:\Program Files\k6",
        "User"
    )
}





