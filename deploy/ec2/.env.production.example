# Copy to deploy/ec2/.env.production on the EC2 instance and fill in real values.
# Never commit .env.production. Do not add AWS access keys; EC2 uses DocEngineEC2Role.

# In Supabase, use the Session pooler connection details (or direct connection if
# reachable from EC2). Use PostgreSQL SSL. Replace the host/project username below.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.project-ref
SPRING_DATASOURCE_PASSWORD=replace-with-supabase-database-password

# Generate a strong unique password and keep this file private on EC2.
RABBITMQ_USER=docengine-prod
RABBITMQ_PASS=replace-with-a-long-random-password

# Existing private bucket and region. The EC2 role must allow GetObject/PutObject
# on the inputs/* and outputs/* prefixes.
DOCENGINE_S3_BUCKET=docengine-prod-jay-253838079954-ap-south-1-an
DOCENGINE_S3_REGION=ap-south-1
DOCENGINE_S3_INPUT_PREFIX=inputs
DOCENGINE_S3_OUTPUT_PREFIX=outputs

# API binds only to loopback; use an SSH tunnel until NGINX/HTTPS is configured.
API_HOST_PORT=8081

# Grafana is bound to EC2 loopback only. Access it via SSH/SSM port forwarding.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-long-random-password
